{
  "name": "api-devops-sqlite",
  "version": "2.0.0",
  "description": "API REST + frontend con CI/CD, pruebas E2E (Playwright) y observabilidad (OpenObserve)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
"test": "jest --runInBand --detectOpenHandles --forceExit --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest": {
    "testTimeout": 30000,
    "testPathIgnorePatterns": ["/node_modules/", "/e2e/"]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.205.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "express": "^5.2.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0"
  }
}
