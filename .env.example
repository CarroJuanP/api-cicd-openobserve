# Copia a .env en el servidor EC2 (NO subir .env al repositorio)
DOCKERHUB_USERNAME=tu_usuario_dockerhub
JWT_SECRET=pon-un-secreto-largo-y-aleatorio
ADMIN_PASSWORD=Admin123!

# OpenObserve
ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=CambiaEstaClave123!
# base64 de "email:password"  ->  echo -n 'admin@example.com:CambiaEstaClave123!' | base64
OO_BASIC_AUTH=YWRtaW5AZXhhbXBsZS5jb206Q2FtYmlhRXN0YUNsYXZlMTIzIQ==

# Temperatura (EC2 normalmente no expone sensores). real | simulated
TEMP_SOURCE=real
